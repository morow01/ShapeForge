{
  "name": "shapeforge",
  "private": true,
  "version": "0.4.35",
  "description": "ShapeForge 3D CAD modeling application",
  "author": "ShapeForge Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:exe": "node electron/pack.cjs",
    "preversion": "npm run build",
    "postversion": "git push && git push --tags",
    "release": "npm run release:patch",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@types/opentype.js": "^1.3.10",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.1",
    "opentype.js": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "replicad": "^1.0.1",
    "replicad-opencascadejs": "^1.0.0",
    "replicad-threejs-helper": "^1.0.0",
    "svgpath": "^2.6.0",
    "three": "^0.185.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.shapeforge.cad",
    "productName": "ShapeForge",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
